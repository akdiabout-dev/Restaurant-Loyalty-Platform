model Order {
  id              String      @id @default(uuid()) @db.Uuid

  branchId        String
  customerId      String

  externalOrderId String?
  // IDEMPOTENCY:
  // externalOrderId identifies the order coming from an external POS/provider.

  status          OrderStatus @default(PENDING)
  orderType       OrderType

  subtotal        Decimal
  discountAmount  Decimal     @default(0)
  taxAmount       Decimal     @default(0)
  tipAmount       Decimal     @default(0)
  total           Decimal

  orderedAt       DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  customer User @relation(fields: [customerId],references: [id])

  items                OrderItem[]
  payments             Payment[]
  loyaltyTransactions  LoyaltyTransaction[]
  promotionRedemptions PromotionRedemption[]

  // IDEMPOTENCY:
  // Same external order cannot be imported twice for the same branch.
  @@unique([branchId, externalOrderId])
}



model OrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String
  productId         String

  productName       String
  quantity          Int

  originalUnitPrice Decimal
  discountAmount    Decimal  @default(0)
  unitPrice         Decimal
  taxAmount         Decimal  @default(0)

  createdAt         DateTime @default(now())

  order Order @relation(fields: [orderId],references: [id])

  product Product @relation( fields: [productId],references: [id] )

  review ProductReview?
}


model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String

  provider          String?

  externalPaymentId String?
  // IDEMPOTENCY:
  // Stable ID returned by payment provider.

  idempotencyKey    String?
  // IDEMPOTENCY:
  // Stable key generated/sent for a payment request.
  // Retried HTTP requests reuse the SAME key.

  method            PaymentMethod
  status            PaymentStatus @default(PENDING)

  amount            Decimal
  currency          String

  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId],references: [id])

  // IDEMPOTENCY:
  // Same payment request for an order cannot create another payment attempt.
  @@unique([orderId, idempotencyKey])

  // IDEMPOTENCY:
  // Same payment returned by the provider cannot be stored twice.
  @@unique([provider, externalPaymentId])
}



enum OrderStatus{
    PENDING
    CONFIREMED
    PREPARING
    READY
    COMPLATED
    CANCELLED
}
enum OrderType{
    DINE_IN
    TAKEAWAY
    DELIVERY
}
enum PaymentMethod{
    CASH
    CARD
    ONLINE
}
enum PaymentStatus{
    PENDING
    PAID
    FAILED
    REFUNDED
    CANCELLED
}